[Unit]
Description=zclid — background wallet daemon for zcli
After=network-online.target
Wants=network-online.target

# A USER unit — install to /etc/systemd/user (or /usr/lib/systemd/user from a
# package) and start with `systemctl --user enable --now zclid`, as
# deploy/README says. It is not a system unit and must not be one:
#
#   - %h is "the home directory of the user running the service manager"; in a
#     SYSTEM unit that is /root regardless of User= (systemd.unit(5)). Every
#     wallet path below would then point into root's home.
#   - User= cannot switch identity in a user manager anyway; for a non-root
#     user the only permitted value is the user itself (systemd.exec(5)).
#   - %i is empty outside a templated unit, and this is zclid.service, not
#     zclid@.service. `User=%i` therefore parsed as an empty user.
#
# zclid holds a spending key and works entirely in per-user paths, so there is
# no reason for root to be involved at all.
[Service]
Type=simple
ExecStart=/usr/local/bin/zclid \
    --endpoint https://zcash.rotko.net \
    --listen 127.0.0.1:9067 \
    --identity %h/.ssh/id_ed25519 \
    --mempool-interval 10 \
    --sync-interval 30
Restart=on-failure
RestartSec=10

# filesystem — needs wallet db + ssh key (read) + socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=%h/.zcli
ReadOnlyPaths=%h/.ssh/id_ed25519
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid

# network — outbound https to zidecar + local listen
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# capabilities — none
CapabilityBoundingSet=
AmbientCapabilities=

# syscall filter
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @clock @cpu-emulation @debug @obsolete @raw-io @privileged
SystemCallArchitectures=native

# memory — spending key protection
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

# no core dumps — spending key must not hit disk
LimitCORE=0

# restrict /proc visibility from other users
UMask=0077

[Install]
WantedBy=default.target
